ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://mantiq:mantiq@localhost:5432/mantiq
JWT_SECRET=replace-with-32+-random-characters
CORS_ORIGINS=["http://localhost:5173"]
STORAGE_DIR=storage
AUDIO_RETENTION_DAYS=30
RETENTION_INTERVAL_MINUTES=60
MAX_AUDIO_SECONDS=120

# Gnani Prisma (STT): live | mock | disabled
PRISMA_MODE=mock
GNANI_API_KEY=
GNANI_BASE_URL=https://api.vachana.ai
PRISMA_MODEL=prisma-v3.0
PRISMA_LANGUAGE_CODE=en-IN   # or hi-IN, indic-auto
PRISMA_USE_KEYTERMS=true

# Gnani Evon (OpenAI-compatible chat completions): live | mock | disabled
EVON_MODE=mock
EVON_BASE_URL=http://localhost:30000/v1
EVON_API_KEY=
EVON_MODEL=gnani/gnani-evon-v3.3-30b-a3b

# Gnani Timbre (TTS, optional): live | mock | disabled
TIMBRE_MODE=disabled
TIMBRE_VOICE=Nalini

# Google Gemini: fix suggestions grounded in Google Search, and English/Hindi translation.
# live needs GEMINI_API_KEY; mock uses the built-in maintenance guide and shows untranslated text.
AI_MODE=mock
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
AI_WEB_SEARCH=true
AI_REQUESTS_PER_USER_PER_HOUR=30
